<?xml version="1.0"?>
<sdf version="1.9">
  <model name="tsukuba">
    <static>true</static>
    <link name="link">
      <!-- 地面に航空写真を貼る。terrain_textured.obj と画像は scripts/make_tsukuba_aerial.py で作る
           (画像の出典: 国土地理院 地理院タイル (全国最新写真 (シームレス))) -->
      <visual name="terrain_visual">
        <geometry><mesh><uri>model://tsukuba/meshes/terrain_textured.obj</uri></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://tsukuba/materials/textures/tsukuba_aerial.jpg</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="terrain_collision">
        <geometry><mesh><uri>model://tsukuba/meshes/terrain_collision.obj</uri></mesh></geometry>
      </collision>
      <visual name="structures_visual">
        <geometry><mesh><uri>model://tsukuba/meshes/structures.obj</uri></mesh></geometry>
        <material>
          <ambient>0.55 0.60 0.68 1</ambient>
          <diffuse>0.55 0.60 0.68 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <collision name="structures_collision">
        <geometry><mesh><uri>model://tsukuba/meshes/structures_collision.obj</uri></mesh></geometry>
      </collision>
    </link>
  </model>
</sdf>
